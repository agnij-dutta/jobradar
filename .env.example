# Job Radar reads no secrets. Every variable is optional.

# Where the snapshot, SQLite history and raw payloads live. Default: ./data
JOBRADAR_DATA_DIR=

# Where boards.json, candidates.json, dead.json and collisions.json live. Default: ./seeds
JOBRADAR_SEEDS_DIR=

# User-Agent sent to the ATS APIs. Add a contact URL or email if you run large sweeps.
JOBRADAR_USER_AGENT=

# Politeness: max concurrent requests per ATS host (default 3) and minimum seconds
# between request starts per host (default 0.25). Please don't lower these much.
JOBRADAR_PER_HOST_CONCURRENCY=
JOBRADAR_MIN_INTERVAL_S=
